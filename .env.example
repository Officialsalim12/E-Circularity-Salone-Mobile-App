# Copy this to .env in the repo root. Don't commit the real file.
# These placeholders are for your machine. Swap them before production.

# development, staging, or production
APP_ENV=development

PORT=3000

# Neon is fine. If the URL has channel_binding=require, the API drops that bit and keeps TLS.
DATABASE_URL=

# Brevo. The sender email has to be verified there.
# Leave the key and sender email empty together, or fill both in.
# The SMS sender can stay empty. Texts just won't send until you put in the 3–11 character id Brevo approved.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Circular Salone
BREVO_SMS_SENDER=

# At least 32 characters. Change these before anyone else uses the app.
ACCESS_TOKEN_SECRET=dev-only-access-token-secret-change-me
TOKEN_HASH_SECRET=dev-only-token-hash-secret-change-me

# The API ignores this. Flutter reads it from --dart-define.
# Emulator: http://10.0.2.2:3000
# A real phone on the same Wi-Fi needs this computer's LAN address.
API_BASE_URL=http://10.0.2.2:3000

# Web client id. Leave empty until Continue with Google is set up.
# The API reads this. The phone gets the same value from --dart-define=GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
